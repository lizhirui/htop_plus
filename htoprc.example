# htop_plus: CPU/RAM, NVIDIA GPUs, 5090 external power cable.
# Copy to htoprc, or run ./htop_plus which creates that local file once.
config_reader_min_version=3
fields=0 48 17 18 38 39 40 2 46 47 49 1
sort_key=46
sort_direction=-1
hide_kernel_threads=1
hide_userland_threads=1
show_thread_names=0
highlight_base_name=1
highlight_megabytes=1
header_margin=1
delay=10
header_layout=two_50_50
column_meters_0=LeftCPUs4 Memory Swap NvidiaGPUs
column_meter_modes_0=1 1 1 1
column_meters_1=RightCPUs4 Tasks LoadAverage Uptime PowerCable
column_meter_modes_1=1 2 2 2 1
