#!/bin/sh
# Use the local layout in a checkout, and a per-user layout after installation.
set -eu
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$launcher_dir/htoprc.example" ]; then
   binary="$launcher_dir/htop"
   defaults="$launcher_dir/htoprc.example"
   config="$launcher_dir/htoprc"
else
   install_prefix=$(CDPATH= cd -- "$launcher_dir/.." && pwd)
   binary="$install_prefix/libexec/htop_plus/htop"
   defaults="$install_prefix/share/htop_plus/htoprc.example"
   config="${XDG_CONFIG_HOME:-$HOME/.config}/htop_plus/htoprc"
fi
if [ ! -x "$binary" ]; then
   echo 'Build first: ./autogen.sh && CC=/usr/bin/gcc ./configure && make -j8' >&2
   exit 1
fi
if [ -z "${HTOPRC:-}" ]; then
   if [ ! -e "$config" ]; then
      mkdir -p -- "$(dirname -- "$config")"
      (umask 077; cp -n -- "$defaults" "$config")
   fi
   HTOPRC="$config"
   export HTOPRC
fi
exec "$binary" "$@"
